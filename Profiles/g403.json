{
	"schemaVersion": 1,
	"id": "g403",
	"name": "G403",
	"match": {
		"nameContains": ["G403"],
		"productIDs": ["0xC082"]
	},
	"buttons": [
		{
			"number": 1,
			"control": "G1 · Primary click",
			"aliases": ["Left"],
			"notes": null
		},
		{
			"number": 2,
			"control": "G2 · Secondary click",
			"aliases": ["Right"],
			"notes": null
		},
		{
			"number": 3,
			"control": "G3 · Middle click",
			"aliases": ["Wheel click"],
			"notes": null
		},
		{
			"number": 4,
			"control": "G4 · Back",
			"aliases": ["Rear thumb"],
			"notes": null
		},
		{
			"number": 5,
			"control": "G5 · Forward",
			"aliases": ["Front thumb"],
			"notes": null
		},
		{
			"number": 6,
			"control": "G6 · DPI button",
			"aliases": ["Top DPI"],
			"notes": null
		}
	],
	"dpiRange": {
		"minimum": 200,
		"maximum": 12000
	},
	"profileIO": {
		"supported": true,
		"capability": "HID++ 2.0 ONBOARD_PROFILES",
		"feature": "0x8100",
		"load": {
			"command": "profiles",
			"engineArguments": "--summary-only --with-dpi --profile <number>",
			"getInfo": "0x00",
			"readSector": "0x50",
			"controlSector": "0; fallback 1 when empty",
			"explicitProfile": "required when multiple slots"
		},
		"save": {
			"strategy": "standard-hidpp20-sector-write",
			"startWrite": "0x60",
			"writeData": "0x70",
			"endWrite": "0x80",
			"chunkBytes": "16",
			"backup": "exact binary sector before write",
			"verify": "CRC and full-sector readback"
		},
		"layout": {
			"buttonRecord": "4 bytes per control",
			"buttonOffsetByFormat": "format 4/5 -> 32; format 6/7 -> 48",
			"crc": "CRC-16/CCITT-FALSE"
		},
		"notes": [
			"This file covers PID 0xC082, the original PMW3366-sensor G403 (Wireless-capable) family. The HERO-sensor refresh (PID 0xC08F) and the wired-only Prodigy variant (PID 0xC083) are separate hardware SKUs cataloged in g403-hero.json and g403-prodigy.json."
		]
	},
	"rgbProfile": {
		"supported": true,
		"profileFormats": [4, 5],
		"baseOffset": 208,
		"recordBytes": 11,
		"colorOffset": 1,
		"zones": [
			{
				"index": 0,
				"name": "Scroll wheel"
			},
			{
				"index": 1,
				"name": "Logo"
			}
		],
		"notes": [
			"Validated legacy onboard RGB records: four 11-byte records begin at offset 208; this device exposes the scroll-wheel and logo zones. Only the three-byte solid-color field is edited."
		]
	},
	"sources": [
		"https://github.com/libratbag/libratbag/blob/master/data/devices/logitech-g403-wireless.device",
		"https://github.com/pwr-Solaar/Solaar/blob/master/lib/logitech_receiver/descriptors.py"
	]
}
