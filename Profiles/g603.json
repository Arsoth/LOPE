		{
			"number": 3,
			"control": "G3 · Middle click",
			"aliases": ["Wheel click"],
			"notes": null
		},
		{
			"number": 4,
			"control": "G4 · Back",
			"aliases": ["Rear thumb"],
			"notes": null
		},
		{
			"number": 5,
			"control": "G5 · Forward",
			"aliases": ["Front thumb"],
			"notes": null
		},
		{
			"number": 6,
			"control": "G6 · DPI button",
			"aliases": ["Top DPI"],
			"notes": null
