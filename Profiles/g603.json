	"dpiRange": {
		"minimum": 200,
		"maximum": 12000
	},
	"refreshGuidance": {
		"sleepDescription": "In Endurance mode, the G603 can enter a low-power sleep state very quickly (the setup guide indicates about 3 seconds without activity).",
		"wakeInstructions": "Keep moving the mouse while LOPE reads it. If it is asleep, turn it on or move/click it, then choose Refresh."
	},
	"profileIO": {
		"supported": true,
		"capability": "HID++ 2.0 ONBOARD_PROFILES · format-3 DPI variant · onboard G-Shift",
		"feature": "0x8100",
		"load": {
			"command": "profiles",
			"engineArguments": "--summary-only --with-dpi --profile <number>",
			"getInfo": "0x00",
			"readSector": "0x50",
			"controlSector": "0; fallback 1 when empty",
			"explicitProfile": "required when multiple slots"
		},
		"save": {
			"strategy": "standard-hidpp20-sector-write",
			"startWrite": "0x60",
			"writeData": "0x70",
			"endWrite": "0x80",
			"chunkBytes": "16",
			"backup": "exact binary sector before write",
			"verify": "CRC and full-sector readback"
		},
		"layout": {
			"buttonRecord": "4 bytes per control",
			"buttonOffsetByFormat": "format 3/4/5 -> 32; format 6/7 -> 48",
			"dpiUnusedStage": "0x0000 on known format-3 firmware",
			"gShift": "Six-record bank at normal button offset +64; enable after validated G603 format-3 fallback detection",
			"crc": "CRC-16/CCITT-FALSE"
		},
		"notes": [
			"The engine accepts both zero-filled and 0xFFFF unused DPI slots for this family; retry a sleeping wireless device before reporting a missing profile."
		]
	},
	"sources": ["https://github.com/libratbag/libratbag/blob/master/data/devices/logitech-g603.device"]
