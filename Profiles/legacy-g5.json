{
	"schemaVersion": 1,
	"id": "legacy-g5",
	"name": "Legacy G5",
	"match": {
		"nameContains": ["G5"],
		"productIDs": ["0xC041", "0xC049"]
	},
	"buttons": [
		{
			"number": 1,
			"control": "G1 · Primary click",
			"aliases": ["Left"],
			"notes": null
		},
		{
			"number": 2,
			"control": "G2 · Secondary click",
			"aliases": ["Right"],
			"notes": null
		},
		{
			"number": 3,
			"control": "G3 · Middle click",
			"aliases": ["Wheel click"],
			"notes": null
		},
		{
			"number": 4,
			"control": "G4 · Back",
			"aliases": ["Rear thumb"],
			"notes": null
		},
		{
			"number": 5,
			"control": "G5 · Forward",
			"aliases": ["Front thumb"],
			"notes": null
		},
		{
			"number": 6,
			"control": "G6 · DPI control",
			"aliases": ["Top DPI"],
			"notes": null
		}
	],
	"dpiRange": {
		"minimum": 200,
		"maximum": 2000
	},
	"profileIO": {
		"supported": false,
		"capability": "legacy HID++ 1.0/LGS onboard profile",
		"feature": "legacy",
		"load": {
			"command": "profiles",
			"engineArguments": "--summary-only --profile <number>",
			"getInfo": "legacy HID++ 1.0",
			"readSector": "legacy/runtime",
			"controlSector": "legacy/runtime",
			"explicitProfile": "required when multiple slots"
		},
		"save": {
			"strategy": "read-only",
			"reason": "Legacy G5 records are not compatible with the standard sector writer",
			"backup": "required",
			"verify": "required"
		},
		"layout": {
			"buttonRecord": "runtime-reported",
			"buttonOffsetByFormat": "legacy/runtime",
			"crc": "runtime-validated"
		},
		"notes": [
			"This is a low-priority legacy descriptor; a more specific future descriptor for this exact model can override it with a higher priority.",
			"The two product IDs were inherited from a combined G5/G7 descriptor and are believed to cover G5's hardware revisions, but have not been independently re-verified against real devices."
		]
	},
	"sources": ["https://github-wiki-see.page/m/libratbag/libratbag/wiki/Devices"]
}
