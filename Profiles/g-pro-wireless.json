{
	"schemaVersion": 1,
	"id": "g-pro-wireless",
	"name": "G PRO Wireless",
	"match": {
		"nameContains": ["G PRO WIRELESS", "PRO WIRELESS"],
		"productIDs": ["0xC088", "0x4079"]
	},
	"buttons": [
		{
			"number": 1,
			"control": "G1 · Primary click",
			"aliases": ["Left"],
			"notes": null
		},
		{
			"number": 2,
			"control": "G2 · Secondary click",
			"aliases": ["Right"],
			"notes": null
		},
		{
			"number": 3,
			"control": "G3 · Middle click",
			"aliases": ["Wheel click"],
			"notes": null
		},
		{
			"number": 4,
			"control": "G4 · Left side rear",
			"aliases": ["Removable side button"],
			"notes": null
		},
		{
			"number": 5,
			"control": "G5 · Left side front",
			"aliases": ["Removable side button"],
			"notes": null
		},
		{
			"number": 6,
			"control": "G6 · Right side rear",
			"aliases": ["Removable side button"],
			"notes": null
		},
		{
			"number": 7,
			"control": "G7 · Right side front",
			"aliases": ["Removable side button"],
			"notes": null
		},
		{
			"number": 8,
			"control": "G8 · Underside DPI",
			"aliases": ["DPI button"],
			"notes": null
		}
	],
	"dpiRange": {
		"minimum": 100,
		"maximum": 25600
	},
	"profileIO": {
		"supported": true,
		"capability": "HID++ 2.0 ONBOARD_PROFILES · optional ambidextrous controls",
		"feature": "0x8100",
		"load": {
			"command": "profiles",
			"engineArguments": "--summary-only --with-dpi --profile <number>",
			"getInfo": "0x00",
			"readSector": "0x50",
			"controlSector": "0; fallback 1 when empty",
			"explicitProfile": "required when multiple slots"
		},
		"save": {
			"strategy": "standard-hidpp20-sector-write",
			"startWrite": "0x60",
			"writeData": "0x70",
			"endWrite": "0x80",
			"chunkBytes": "16",
			"backup": "exact binary sector before write",
			"verify": "CRC and full-sector readback"
		},
		"layout": {
			"buttonRecord": "4 bytes per control",
			"buttonOffsetByFormat": "format 4/5 -> 32; format 6/7 -> 48",
			"optionalSideButtons": "four side records can be physically capped",
			"crc": "CRC-16/CCITT-FALSE"
		},
		"notes": [
			"The underside DPI control is part of the eight-record maximum; installed side-button caps determine the useful side controls."
		]
	},
	"sources": [
		"https://www.logitechg.com/en-us/shop/p/pro-wireless-mouse",
		"https://github.com/libratbag/libratbag/blob/master/data/devices/logitech-g-pro-wireless.device"
	]
}
