{
	"schemaVersion": 1,
	"id": "g502",
	"name": "G502 HERO / LIGHTSPEED",
	"match": {
		"nameContains": ["G502 HERO", "G502 LIGHTSPEED", "G502"],
		"productIDs": ["0xC07D", "0xC332"],
		"priority": 30
	},
	"buttons": [
		{
			"number": 1,
			"control": "G1 · Primary click",
			"aliases": ["Left"],
			"notes": null
		},
		{
			"number": 2,
			"control": "G2 · Secondary click",
			"aliases": ["Right"],
			"notes": null
		},
		{
			"number": 3,
			"control": "G3 · Middle click",
			"aliases": ["Wheel click"],
			"notes": null
		},
		{
			"number": 4,
			"control": "G4 · Back",
			"aliases": ["Rear thumb"],
			"notes": null
		},
		{
			"number": 5,
			"control": "G5 · Forward",
			"aliases": ["Front thumb"],
			"notes": null
		},
		{
			"number": 6,
			"control": "G6 · DPI Shift",
			"aliases": ["Sniper"],
			"notes": null
		},
		{ "number": 7, "control": "G7 · DPI down", "aliases": [], "notes": null },
		{ "number": 8, "control": "G8 · DPI up", "aliases": [], "notes": null },
		{
			"number": 9,
			"control": "Wheel tilt left",
			"aliases": ["Scroll left"],
			"notes": null
		},
		{
			"number": 10,
			"control": "Wheel tilt right",
			"aliases": ["Scroll right"],
			"notes": null
		},
		{
			"number": 11,
			"control": "G9 · Profile",
			"aliases": ["Profile cycle"],
			"notes": null
		}
	],
	"dpiRange": { "minimum": 100, "maximum": 25600 },
	"profileIO": {
		"supported": true,
		"capability": "HID++ 2.0 ONBOARD_PROFILES",
		"feature": "0x8100",
		"load": {
			"command": "profiles",
			"engineArguments": "--summary-only --with-dpi --profile <number>",
			"getInfo": "0x00",
			"readSector": "0x50",
			"controlSector": "0; fallback 1 when empty",
			"explicitProfile": "required when multiple slots"
		},
		"save": {
			"strategy": "standard-hidpp20-sector-write",
			"startWrite": "0x60",
			"writeData": "0x70",
			"endWrite": "0x80",
			"chunkBytes": "16",
			"backup": "exact binary sector before write",
			"verify": "CRC and full-sector readback"
		},
		"layout": {
			"buttonRecord": "4 bytes per control",
			"buttonOffsetByFormat": "format 4/5 -> 32; format 6/7 -> 48",
			"crc": "CRC-16/CCITT-FALSE"
		},
		"notes": [
			"This is the original G502/HERO/LIGHTSPEED order. Do not reuse it for G502 X: the X family moves the DPI and tilt records."
		]
	},
	"rgbProfile": {
		"supported": true,
		"profileFormats": [4, 5],
		"baseOffset": 208,
		"recordBytes": 11,
		"colorOffset": 1,
		"zones": [
			{ "index": 0, "name": "Primary" },
			{ "index": 1, "name": "Logo" }
		],
		"notes": [
			"Validated legacy onboard RGB records: four 11-byte records begin at offset 208; this device exposes the Primary/DPI and Logo zones. Only the three-byte solid-color field is edited."
		]
	},
	"sources": [
		"https://secure.logitech.com/assets/50955/g502-proteus-core-setup-guide.pdf",
