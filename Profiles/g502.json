			},
			{
				"index": 1,
				"name": "Logo"
			}
		],
		"notes": [
			"Validated legacy onboard RGB records: four 11-byte records begin at offset 208; this device exposes the DPI and Logo zones. Only the three-byte solid-color field is edited."
		]
	},
