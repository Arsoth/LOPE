		},
		"layout": {
			"buttonRecord": "runtime-reported",
			"buttonOffsetByFormat": "runtime-validated",
			"crc": "runtime-validated"
		},
		"notes": [
			"The 2, 2C, 2 SE, and DEX models expose the same five-button logical mapping in product specifications, but their profile transport must be verified per firmware family."
		]
	},
	"sources": [
