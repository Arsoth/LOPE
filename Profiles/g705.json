{
	"schemaVersion": 1,
	"id": "g705",
	"name": "G705",
	"match": { "nameContains": ["G705"], "productIDs": [], "priority": 30 },
	"buttons": [
		{
			"number": 1,
			"control": "G1 · Primary click",
			"aliases": ["Left"],
			"notes": null
		},
		{
			"number": 2,
			"control": "G2 · Secondary click",
			"aliases": ["Right"],
			"notes": null
		},
		{
			"number": 3,
			"control": "G3 · Middle click",
			"aliases": ["Wheel click"],
			"notes": null
		},
		{
			"number": 4,
			"control": "G4 · Back",
			"aliases": ["Rear thumb"],
			"notes": null
		},
		{
			"number": 5,
			"control": "G5 · Forward",
			"aliases": ["Front thumb"],
			"notes": null
		},
		{
			"number": 6,
			"control": "G6 · DPI Shift",
			"aliases": ["Top-mounted DPI"],
			"notes": null
		}
	],
	"dpiRange": { "minimum": 100, "maximum": 8200 },
	"keyboardOutput": { "maxKeys": 1, "maxLength": 1 },
	"profileIO": {
		"supported": false,
		"capability": "HID++ profile transport unverified",
		"feature": "0x8100",
		"load": {
			"command": "profiles",
			"engineArguments": "--summary-only --with-dpi --profile <number>",
			"getInfo": "0x00",
			"readSector": "0x50",
			"controlSector": "runtime-detected",
			"explicitProfile": "required when multiple slots"
		},
		"save": {
			"strategy": "read-only",
			"reason": "Confirm the Aurora firmware's profile format and sector layout before enabling writes",
			"backup": "required",
			"verify": "required"
		},
		"layout": {
			"buttonRecord": "4 bytes per control if standard HID++",
			"buttonOffsetByFormat": "runtime-validated",
			"crc": "runtime-validated"
		},
		"notes": [
			"The six-button physical mapping follows Logitech's documented two-thumb-button plus top DPI layout; transport remains conservative until hardware capture is available."
		]
	},
	"sources": [
		"https://www.logitechg.com/en-us/products/gaming-mice/g705-wireless-gaming-mouse.html"
	]
