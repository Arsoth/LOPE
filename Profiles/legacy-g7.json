{
	"schemaVersion": 1,
	"id": "legacy-g7",
	"name": "Legacy G7",
	"match": {
		"nameContains": ["G7"],
		"productIDs": ["0xC51A"]
	},
	"buttons": [
		{
			"number": 1,
			"control": "G1 · Primary click",
			"aliases": ["Left"],
			"notes": null
		},
		{
			"number": 2,
			"control": "G2 · Secondary click",
			"aliases": ["Right"],
			"notes": null
		},
		{
			"number": 3,
			"control": "G3 · Middle click",
			"aliases": ["Wheel click"],
			"notes": null
		},
		{
			"number": 4,
			"control": "G4 · Back",
			"aliases": ["Rear thumb"],
			"notes": null
		},
		{
			"number": 5,
			"control": "G5 · DPI decrease",
			"aliases": ["Minus (-)"],
			"notes": null
		},
		{
			"number": 6,
			"control": "G6 · DPI increase",
			"aliases": ["Plus (+)"],
			"notes": null
		}
	],
	"dpiRange": {
		"minimum": 200,
		"maximum": 2000
	},
	"profileIO": {
		"supported": false,
		"capability": "legacy HID++ 1.0/LGS onboard profile",
		"feature": "legacy",
		"load": {
			"command": "profiles",
			"engineArguments": "--summary-only --profile <number>",
			"getInfo": "legacy HID++ 1.0",
			"readSector": "legacy/runtime",
			"controlSector": "legacy/runtime",
			"explicitProfile": "required when multiple slots"
		},
		"save": {
			"strategy": "read-only",
			"reason": "Legacy G7 records are not compatible with the standard sector writer",
			"backup": "required",
			"verify": "required"
		},
		"layout": {
			"buttonRecord": "runtime-reported",
			"buttonOffsetByFormat": "legacy/runtime",
			"crc": "runtime-validated"
		},
		"notes": [
			"This is a low-priority legacy descriptor; a more specific future descriptor for this exact model can override it with a higher priority.",
			"The product ID was inherited from a combined G5/G7 descriptor and is believed to be G7's cordless receiver ID, but has not been independently re-verified against a real device.",
			"Buttons corrected 2026-09-17: official Logitech G7 Technical Specifications page confirms no Forward button exists (only Back) and DPI adjustment is two separate buttons (Minus/Plus), not a single 'DPI control' button. Total count (6) is unchanged, only composition of G5/G6."
		]
	},
	"sources": [
		"https://github-wiki-see.page/m/libratbag/libratbag/wiki/Devices",
		"https://support.logi.com/hc/en-us/articles/360023307894-G7-Technical-Specifications"
	]
}
