#!/usr/bin/env bash
# Installed via `make install-hooks`. Blocks commits that fail formatting or
# the focused tests and coverage checks for staged source changes. Pull
# requests and the nightly workflow run the full repository gate.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$script_dir"

echo "pre-commit: checking formatting and lint..."
make format-check

echo "pre-commit: running staged-file test and coverage gate..."
MODIFIED_TESTS_STAGED_ONLY=1 make test-modified
