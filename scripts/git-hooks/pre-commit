#!/usr/bin/env bash
# Installed via `make install-hooks`. Blocks commits that fail formatting,
# linting, the self-test suite, or the per-file coverage minimums. The
# coverage gate is intentionally strict (see docs/development-standards.md).

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$script_dir"

echo "pre-commit: checking formatting and lint..."
make format-check

echo "pre-commit: running tests..."
make test

echo "pre-commit: checking coverage..."
make coverage-check
